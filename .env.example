# Supabase Authentication & Realtime Configuration
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Database API URL (defaults to /api on the current host)
PUBLIC_DATABASE_API_URL=/api

# Turso Database Configuration (optional; defaults to local embedded SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin User Identification
ADMIN_EMAIL=dinosaurkiril@gmail.com

# Gemini API Key (optional server-side default or configured by user in UI)
GEMINI_API_KEY=
