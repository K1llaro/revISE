---
// src/pages/auth/callback.astro
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>revISE - Authenticating...</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #060c20;
        color: #f8fafc;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        text-align: center;
      }
      .card {
        padding: 2rem;
        border-radius: 1rem;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        max-width: 400px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      }
      .spinner {
        width: 36px;
        height: 36px;
        border: 3px solid rgba(60, 203, 87, 0.2);
        border-top-color: #3ccb57;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 1.25rem;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      h2 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
      }
      p {
        margin: 0;
        font-size: 0.875rem;
        color: #94a3b8;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="spinner"></div>
      <h2>Completing sign-in...</h2>
      <p id="status-text">Synchronizing your session. This window will close automatically.</p>
    </div>

    <script>
      import { supabase } from '../../lib/supabase';

      const finishAuth = async () => {
        try {
          const { data, error } = await supabase.auth.getSession();
          if (error) {
            console.warn('Session retrieval note in callback:', error);
          }

          if (window.opener) {
            window.opener.postMessage({ type: 'OAUTH_AUTH_SUCCESS', session: data?.session }, '*');
            setTimeout(() => {
              window.close();
            }, 300);
          } else {
            window.location.href = '/';
          }
        } catch (err) {
          console.error('Failed to complete callback:', err);
          if (window.opener) {
            window.opener.postMessage({ type: 'OAUTH_AUTH_ERROR', error: String(err) }, '*');
            setTimeout(() => window.close(), 1000);
          } else {
            window.location.href = '/';
          }
        }
      };

      finishAuth();
    </script>
  </body>
</html>
